global
	maxconn 100

defaults
	log	global
	mode	tcp
	retries 2
	timeout client 30m
	timeout connect 4s
	timeout server 30m
	timeout check 5s

listen stats
	mode http
	bind *:{{ getenv "HAPROXY_STATS_PORT" "7000" }}
	stats enable
	stats uri /

listen primary
	bind *:{{ getenv "HAPROXY_PRIMARY_PORT" "5000" }}
	option httpchk HEAD /primary
	http-check expect status 200
	default-server inter 3s fall 3 rise 2 on-marked-down shutdown-sessions
{{range gets "/members/*"}}	server {{base .Key}} {{$data := json .Value}}{{base (replace (index (split $data.conn_url "/") 2) "@" "/" -1)}} maxconn 100 check port {{$hostport := index (split $data.api_url "/") 2}}{{if gt (len (split $hostport "]")) 1}}{{index (split (index (split $hostport "]") 1) ":") 1}}{{else}}{{index (split $hostport ":") 1}}{{end}}
{{end}}
listen replicas
	bind *:{{ getenv "HAPROXY_REPLICA_PORT" "5001" }}
	option httpchk HEAD /replica
	http-check expect status 200
	default-server inter 3s fall 3 rise 2 on-marked-down shutdown-sessions
{{range gets "/members/*"}}	server {{base .Key}} {{$data := json .Value}}{{base (replace (index (split $data.conn_url "/") 2) "@" "/" -1)}} maxconn 100 check port {{$hostport := index (split $data.api_url "/") 2}}{{if gt (len (split $hostport "]")) 1}}{{index (split (index (split $hostport "]") 1) ":") 1}}{{else}}{{index (split $hostport ":") 1}}{{end}}
{{end}}